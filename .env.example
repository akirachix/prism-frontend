# Backend base URL, no trailing slash. The backend must allow this app's origin in CORS.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# "true" -> every feature uses its own mocks.ts and never touches the network.
NEXT_PUBLIC_USE_MOCKS=false
NEXT_PUBLIC_MOCK_DELAY_MS=300
NEXT_PUBLIC_APP_NAME=Mirai
